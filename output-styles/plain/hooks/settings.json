{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/root/.claude/hooks/style-reminder.sh"
          }
        ]
      }
    ]
  },
  "outputStyle": "Plain",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "remoteControlAtStartup": true
}
